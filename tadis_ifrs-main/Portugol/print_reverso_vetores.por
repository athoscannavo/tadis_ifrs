programa
{
	
	funcao inicio()
	{

	/*Crie um algoritmo que leia um vetor de 10 posições e
depois apresente este vetor em ordem inversa na tela.*/
	inteiro v[10]
	inteiro i

	para(i=0 ; i<10 ; i++){
		leia(v[i])
	}

	para(i=9; i>=0; i--){
		escreva("\n", v[i])
	}
			

	
	
	}
}
